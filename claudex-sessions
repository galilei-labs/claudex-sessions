#!/usr/bin/env python3
"""claudex-sessions: list Claude Code and Codex sessions, live and past, with a fuzzy picker.

Claude: live sessions come from the registry in ~/.claude/sessions/<pid>.json
(kept only while the process is alive); past ones from ~/.claude/projects.
Codex: threads come from ~/.codex/state_*.sqlite; a thread is live while a codex
process holds its lock in ~/.codex/thread-writer-locks.
Green dot = live, grey dot = past (revivable with `claude --resume` / `codex resume`).

Usage:
  claudex-sessions [QUERY...]        interactive picker (QUERY pre-fills the filter)
  claudex-sessions -r | --resume     picker, then revive the chosen session in its cwd
  claudex-sessions -R                same, with --dangerously-skip-permissions
  claudex-sessions -r -- FLAGS...    extra FLAGS are passed through to claude / codex
  claudex-sessions -l | --list       plain table, no interaction
  claudex-sessions --live            only sessions that are currently running
  claudex-sessions --json            sessions as JSON
  claudex-sessions --cwd  [QUERY]    print the chosen session's working directory
  claudex-sessions --name [QUERY]    print the chosen session's name
  claudex-sessions -n N              keep only the N most recent past sessions
  claudex-sessions --claude|--codex  only sessions of that tool (type "codex" to filter too)

  claudex-sessions -f | --focus      bring the chosen live session's terminal tab to front
  claudex-sessions --no-focus        never focus (default when stdout is not a TTY)

Enter on a live session focuses its Terminal.app / iTerm2 tab (when stdout is a
TTY). The session ID is always printed to stdout (details go to stderr), so it
composes:   cd "$(claudex-sessions --cwd)"     claude --resume "$(claudex-sessions)"

Keys: type to filter · ↑/↓ or ^P/^N move · Enter select · Esc/^C quit
"""
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

SESS_DIR = Path.home() / ".claude" / "sessions"
PROJ_DIR = Path.home() / ".claude" / "projects"
CODEX_DIR = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "claudex-sessions" / "index.json"

# ── ANSI helpers ─────────────────────────────────────────────────────────────
ESC = "\x1b["
RESET, BOLD, DIM = ESC + "0m", ESC + "1m", ESC + "2m"
GREEN, YELLOW, RED, CYAN, MAGENTA = (ESC + c for c in ("32m", "33m", "31m", "36m", "35m"))
REV = ESC + "7m"


def strip_ansi(s):
    return re.sub(r"\x1b\[[0-9;]*m", "", s)


# ── Data ─────────────────────────────────────────────────────────────────────
def proc_comm(pid):
    try:
        out = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=2).stdout.strip()
        return out or None
    except Exception:
        return None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def load_registry():
    """Live sessions from ~/.claude/sessions, keyed by sessionId."""
    live = {}
    if not SESS_DIR.is_dir():
        return live
    for f in SESS_DIR.glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except Exception:
            continue
        pid = d.get("pid")
        if not isinstance(pid, int) or not alive(pid):
            continue
        # Guard against PID reuse: make sure the pid still belongs to claude.
        comm = proc_comm(pid)
        if comm is not None and "claude" not in os.path.basename(comm).lower() \
                and "node" not in os.path.basename(comm).lower():
            continue
        d["alive"] = True
        live[d.get("sessionId")] = d
    return live


def iso_ms(ts):
    """'2026-09-04T11:33:52.649Z' -> epoch ms, or None."""
    try:
        from datetime import datetime, timezone
        return int(datetime.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")
                   .replace(tzinfo=timezone.utc).timestamp() * 1000)
    except Exception:
        return None


def scan_transcript(path):
    """Cheap single pass over a transcript: title, cwd, first/last time, prompts."""
    info = {"sessionId": path.stem, "prompts": 0, "custom": None, "ai": None,
            "cwd": None, "first": None, "last": None, "firstPrompt": None}
    try:
        with open(path, "rb") as fh:
            for raw in fh:
                if raw.startswith(b'{"type":"custom-title"'):
                    try:
                        info["custom"] = json.loads(raw).get("customTitle") or info["custom"]
                    except Exception:
                        pass
                    continue
                if raw.startswith(b'{"type":"ai-title"'):
                    try:
                        info["ai"] = json.loads(raw).get("aiTitle") or info["ai"]
                    except Exception:
                        pass
                    continue
                if b'"timestamp"' not in raw:
                    continue
                m = re.search(rb'"timestamp":"([^"]+)"', raw)
                if m:
                    info["last"] = m.group(1).decode()
                    if info["first"] is None:
                        info["first"] = info["last"]
                if info["cwd"] is None:
                    m = re.search(rb'"cwd":"([^"]+)"', raw)
                    if m:
                        info["cwd"] = m.group(1).decode()
                if b'"type":"user"' in raw and b'"isMeta":true' not in raw \
                        and b'"role":"user","content":"' in raw:
                    info["prompts"] += 1
                    if info["firstPrompt"] is None:
                        try:
                            c = json.loads(raw)["message"]["content"]
                            if isinstance(c, str) and not c.startswith("<"):
                                info["firstPrompt"] = " ".join(c.split())[:60]
                        except Exception:
                            pass
    except OSError:
        return None
    return info


def load_transcripts():
    """Past (and live) sessions from ~/.claude/projects/*/<id>.jsonl."""
    out = {}
    if not PROJ_DIR.is_dir():
        return out
    try:
        cache = json.loads(CACHE.read_text())
    except Exception:
        cache = {}
    fresh, dirty = {}, False
    for path in PROJ_DIR.glob("*/*.jsonl"):
        try:
            st = path.stat()
        except OSError:
            continue
        key = str(path)
        stamp = [st.st_size, int(st.st_mtime)]
        hit = cache.get(key)
        if hit and hit.get("stamp") == stamp:
            info = hit["info"]
        else:
            info = scan_transcript(path)
            dirty = True
        fresh[key] = {"stamp": stamp, "info": info}
        if not info or (info["prompts"] == 0 and not info["custom"]):
            continue
        out[info["sessionId"]] = info
    if dirty or set(fresh) != set(cache):
        try:
            CACHE.parent.mkdir(parents=True, exist_ok=True)
            CACHE.write_text(json.dumps(fresh))
        except OSError:
            pass
    return out


# ── Codex ────────────────────────────────────────────────────────────────────
def codex_db():
    """Newest ~/.codex/state_<N>.sqlite, or None."""
    def ver(p):
        m = re.search(r"state_(\d+)\.sqlite$", p.name)
        return int(m.group(1)) if m else -1
    dbs = sorted(CODEX_DIR.glob("state_*.sqlite"), key=ver)
    return dbs[-1] if dbs else None


def codex_locked_threads():
    """IDs of Codex threads whose writer lock is held by a running process."""
    lock_dir = CODEX_DIR / "thread-writer-locks"
    locks = [str(p) for p in lock_dir.glob("*.lock")] if lock_dir.is_dir() else []
    if not locks:
        return set()
    try:
        out = subprocess.run(["lsof", "-Fn", *locks], capture_output=True,
                             text=True, timeout=5).stdout
    except Exception:  # no lsof: a lock file is removed when its thread closes
        return {Path(p).stem for p in locks}
    return {Path(l[1:]).stem for l in out.splitlines() if l.startswith("n")}


def codex_tuis():
    """Interactive codex processes as [(pid, cwd)], oldest pid first."""
    try:
        out = subprocess.run(["ps", "-axo", "pid=,tty=,comm="], capture_output=True,
                             text=True, timeout=5).stdout
    except Exception:
        return []
    pids = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[1] not in ("??", "?") \
                and os.path.basename(parts[2]).lower() == "codex":
            pids.append(parts[0])
    if not pids:
        return []
    try:
        out = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn", "-p", ",".join(pids)],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return []
    procs, pid = [], None
    for l in out.splitlines():
        if l.startswith("p"):
            pid = int(l[1:])
        elif l.startswith("n") and pid:
            procs.append((pid, l[1:]))
    return sorted(procs)


def codex_status(rollout):
    """'busy' if the last turn in the rollout is still running, else 'idle'."""
    try:
        with open(rollout, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - 65536))
            tail = fh.read()
    except OSError:
        return "idle"
    started = tail.rfind(b'"type":"task_started"')
    ended = max(tail.rfind(b'"type":"task_complete"'), tail.rfind(b'"type":"turn_aborted"'))
    return "busy" if started > ended else "idle"


def load_codex(live_only=False):
    db = codex_db()
    if db is None:
        return []
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
        con.row_factory = sqlite3.Row
        rows = con.execute(
            "SELECT * FROM threads WHERE archived = 0 AND attached_thread_parent_id IS NULL "
            "AND agent_role IS NULL AND (COALESCE(name, '') != '' OR first_user_message != '')"
        ).fetchall()
        con.close()
    except sqlite3.Error:
        return []
    locked = codex_locked_threads()
    tuis = codex_tuis()
    out = []
    # Oldest live thread first, so it pairs with the oldest codex process in its cwd.
    for r in sorted(rows, key=lambda r: r["created_at_ms"] or 0):
        r = dict(r)
        alive = r["id"] in locked
        if live_only and not alive:
            continue
        pid = None
        if alive:
            for i, (p, cwd) in enumerate(tuis):
                if cwd == r["cwd"]:
                    pid = tuis.pop(i)[0]
                    break
        prompt = " ".join((r.get("first_user_message") or "").split())[:60] or None
        out.append({
            "sessionId": r["id"], "tool": "codex", "alive": alive, "pid": pid,
            "status": codex_status(r["rollout_path"]) if alive else "past",
            "cwd": r["cwd"], "name": r.get("name") or prompt,
            # Codex thread names (auto or /rename) are what `codex resume NAME` takes.
            "nameSource": "user" if r.get("name") else "prompt",
            "aiTitle": None, "prompts": None,
            "startedAt": r.get("created_at_ms"), "updatedAt": r.get("updated_at_ms"),
        })
    return out


def load_sessions(live_only=False, limit=None, tools=("claude", "codex")):
    live = load_registry() if "claude" in tools else {}
    past = {} if live_only or "claude" not in tools else load_transcripts()
    sessions = []
    for sid, d in live.items():
        t = past.get(sid)
        if t:
            d["aiTitle"] = t["ai"]
            d["prompts"] = t["prompts"]
        d["tool"] = "claude"
        sessions.append(d)
    dead = []
    if "codex" in tools:
        for d in load_codex(live_only):
            (sessions if d["alive"] else dead).append(d)
    for sid, t in past.items():
        if sid in live:
            continue
        name = t["custom"] or t["ai"] or t["firstPrompt"]
        dead.append({
            "sessionId": sid, "tool": "claude", "alive": False, "pid": None, "status": "past",
            "cwd": t["cwd"], "name": name,
            "nameSource": "user" if t["custom"] else ("ai" if t["ai"] else "prompt"),
            "aiTitle": t["ai"], "prompts": t["prompts"],
            "startedAt": iso_ms(t["first"] or ""), "updatedAt": iso_ms(t["last"] or ""),
        })
    key = lambda d: d.get("updatedAt") or d.get("startedAt") or 0
    sessions.sort(key=key, reverse=True)
    dead.sort(key=key, reverse=True)
    if limit is not None:
        dead = dead[:limit]
    return sessions + dead


def display_name(d):
    """User-set name, else the session ID (with the derived name as a hint)."""
    if d.get("nameSource") == "user" and d.get("name"):
        return d["name"], True
    return (d.get("sessionId") or "?")[:8], False


def name_hint(d):
    """Secondary label for unnamed sessions: derived name or AI title."""
    return d.get("aiTitle") or d.get("name") or ""


def short_cwd(p):
    home = str(Path.home())
    if p and p.startswith(home):
        p = "~" + p[len(home):]
    return p or ""


def ago(ms):
    if not ms:
        return ""
    s = int(time.time() - ms / 1000)
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def haystack(d):
    """(text for substring matching, tokens for per-token fuzzy matching).

    Session IDs and pids only take part in substring matching: hex soup makes
    subsequence matches meaningless.
    """
    fuzzy_src = " ".join(str(x) for x in (
        d.get("name"), d.get("aiTitle"), short_cwd(d.get("cwd")), d.get("status"),
        d.get("tool")) if x).lower()
    text = fuzzy_src + " " + " ".join(str(x) for x in (d.get("sessionId"), d.get("pid")) if x).lower()
    tokens = [t for t in re.split(r"[^a-z0-9]+", fuzzy_src) if t]
    return text, tokens


def subseq_spread(word, token):
    """Length of the shortest-first subsequence window of word in token, or None."""
    i, first, last = 0, -1, -1
    for j, ch in enumerate(token):
        if ch == word[i]:
            if first < 0:
                first = j
            last = j
            i += 1
            if i == len(word):
                return last - first
    return None


def fuzzy(word, text, tokens):
    """Score a query word against a haystack (lower is better), or None.

    A contiguous substring anywhere wins; otherwise the word must be a
    subsequence of a single token (so "crp" hits "corpo" but "corpo" does not
    hit "kattis-contract ... projects").
    """
    if word in text:
        return text.index(word)
    best = None
    for tok in tokens:
        sp = subseq_spread(word, tok)
        if sp is not None and (best is None or sp < best):
            best = sp
    return None if best is None else 1000 + best


def filter_sessions(sessions, query):
    words = query.lower().split()
    if not words:
        return list(sessions)
    scored = []
    for d in sessions:
        text, tokens = haystack(d)
        total = 0
        for w in words:
            s = fuzzy(w, text, tokens)
            if s is None:
                break
            total += s
        else:
            scored.append((total, d))
    scored.sort(key=lambda t: t[0])
    return [d for _, d in scored]


# ── Rendering ────────────────────────────────────────────────────────────────
def status_dot(d):
    st = d.get("status") or "?"
    if not d.get("alive"):
        return DIM + "○" + RESET, "past"
    color = {"idle": GREEN, "busy": YELLOW}.get(st, CYAN)
    return color + "●" + RESET, st


def row(d, width, selected=False, color=True):
    dot, st = status_dot(d)
    name, is_user = display_name(d)
    hint = name_hint(d)
    if not is_user and hint:
        room = 40 - len(name) - 4
        hint = hint if len(hint) <= room else hint[:room - 1] + "…"
        name_col = name + DIM + f"  ({hint})" + RESET
        plain_name = f"{name}  ({hint})"
    else:
        name_col = (BOLD + name + RESET) if is_user else name
        plain_name = name
    pad = max(0, 40 - len(plain_name))
    cwd = short_cwd(d.get("cwd"))
    pid = d.get("pid") or ""
    tool = d.get("tool") or "claude"
    tool_col = (MAGENTA if tool == "codex" else DIM) + f"{tool:<6}" + RESET
    right = f"{ago(d.get('updatedAt') or d.get('startedAt')):>4}  {st:<4} {tool_col} {pid:>6}"
    # Trim cwd so the line fits the terminal.
    used = 2 + len(plain_name) + pad + 2 + len(strip_ansi(right)) + 2
    room = max(8, width - used)
    if len(cwd) > room:
        cwd = "…" + cwd[-(room - 1):]
    cwd_pad = max(0, room - len(cwd))
    line = f"{dot} {name_col}{' ' * pad}  {DIM}{cwd}{RESET}{' ' * cwd_pad}  {right}"
    if not color:
        line = strip_ansi(line)
    if selected:
        line = REV + strip_ansi(line) + RESET
    return line


def term_size():
    try:
        sz = os.get_terminal_size(sys.stderr.fileno())
        if sz.columns > 0 and sz.lines > 0:
            return sz.columns, sz.lines
        return 100, 24
    except OSError:
        return 100, 24


def print_table(sessions, color):
    width, _ = term_size()
    for d in sessions:
        print(row(d, width, color=color))


# ── Interactive picker ───────────────────────────────────────────────────────
def pick(sessions, query=""):
    import termios
    import tty

    err = sys.stderr
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sel = 0
    drawn = 0

    def draw():
        nonlocal drawn, sel
        width, height = term_size()
        matches = filter_sessions(sessions, query)
        sel = max(0, min(sel, len(matches) - 1))
        max_rows = max(1, height - 3)
        top = max(0, min(sel - max_rows + 1, len(matches) - max_rows)) if len(matches) > max_rows else 0
        visible = matches[top:top + max_rows]
        # Move to top of previously drawn block and clear it.
        out = ("\r" + ESC + f"{drawn}A" if drawn else "\r") + ESC + "J"
        out += f"{CYAN}❯{RESET} {query}{DIM}▏{RESET}  {DIM}{len(matches)}/{len(sessions)}{RESET}\r\n"
        for i, d in enumerate(visible):
            out += row(d, width, selected=(top + i == sel)) + "\r\n"
        if not matches:
            out += f"{DIM}  no match{RESET}\r\n"
        drawn = 1 + max(1, len(visible))
        err.write(out)
        err.flush()
        return matches

    try:
        tty.setraw(fd)
        err.write(ESC + "?25l")  # hide cursor
        matches = draw()
        while True:
            ch = os.read(fd, 1)
            if ch == b"\x1b":  # escape or arrow sequence
                seq = os.read(fd, 2) if _pending(fd) else b""
                if seq == b"[A":
                    sel -= 1
                elif seq == b"[B":
                    sel += 1
                elif seq == b"":
                    return None
            elif ch in (b"\x03", b"\x04"):  # ^C ^D
                return None
            elif ch in (b"\r", b"\n"):
                return matches[sel] if matches else None
            elif ch in (b"\x7f", b"\x08"):
                query = query[:-1]
            elif ch == b"\x15":  # ^U
                query = ""
            elif ch == b"\x17":  # ^W
                query = query.rstrip()
                query = query[:query.rfind(" ") + 1] if " " in query else ""
            elif ch == b"\x10":  # ^P
                sel -= 1
            elif ch == b"\x0e":  # ^N
                sel += 1
            elif ch == b"\t":
                sel += 1
            elif ch >= b" ":
                try:
                    query += ch.decode()
                except UnicodeDecodeError:
                    pass
            if sel < 0:
                sel = max(0, len(matches) - 1)
            matches = draw()
    finally:
        err.write(ESC + "?25h")
        err.write("\r" + ESC + f"{drawn}A" + ESC + "J" if drawn else "")
        err.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def _pending(fd):
    import select
    r, _, _ = select.select([fd], [], [], 0.02)
    return bool(r)


# ── Focus the terminal tab of a live session ─────────────────────────────────
def ps_field(pid, field):
    try:
        return subprocess.run(["ps", "-o", f"{field}=", "-p", str(pid)],
                              capture_output=True, text=True, timeout=2).stdout.strip()
    except Exception:
        return ""


def terminal_app(pid):
    """Walk up the parent chain and name the terminal emulator, if recognised."""
    known = {"terminal": "Terminal", "iterm2": "iTerm2", "iterm": "iTerm2",
             "ghostty": "Ghostty", "kitty": "kitty", "wezterm-gui": "WezTerm",
             "alacritty": "Alacritty", "warp": "Warp", "code": "VS Code", "cursor": "Cursor"}
    for _ in range(20):
        comm = os.path.basename(ps_field(pid, "comm")).lower()
        for k, v in known.items():
            if comm == k or comm.startswith(k + "."):
                return v
        ppid = ps_field(pid, "ppid")
        if not ppid.isdigit() or int(ppid) <= 1:
            break
        pid = int(ppid)
    return None


OSA_TERMINAL = '''
on run argv
  set target to item 1 of argv
  tell application "Terminal"
    repeat with w in windows
      repeat with t in tabs of w
        if (tty of t) is target then
          set selected tab of w to t
          set index of w to 1
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end tell
  return "notfound"
end run
'''

OSA_ITERM = '''
on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (tty of s) is target then
            select t
            select w
            activate
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "notfound"
end run
'''


def focus(d):
    """Bring the terminal tab hosting live session d to the front. Returns True on success."""
    pid = d.get("pid")
    if not pid:
        return False
    tty = ps_field(pid, "tty")
    if not tty or tty == "??":
        print("focus: session has no tty", file=sys.stderr)
        return False
    dev = tty if tty.startswith("/dev/") else "/dev/" + tty
    app = terminal_app(pid)
    script = {"Terminal": OSA_TERMINAL, "iTerm2": OSA_ITERM}.get(app)
    if script is None:
        print(f"focus: don't know how to focus {app or 'this terminal'} (tty {dev})", file=sys.stderr)
        return False
    try:
        r = subprocess.run(["osascript", "-", dev], input=script, capture_output=True,
                           text=True, timeout=10)
    except Exception as e:
        print(f"focus: osascript failed: {e}", file=sys.stderr)
        return False
    if r.returncode != 0 or r.stdout.strip() != "ok":
        msg = r.stderr.strip() or r.stdout.strip() or "tab not found"
        print(f"focus: {app}: {msg}", file=sys.stderr)
        return False
    return True


# ── Main ─────────────────────────────────────────────────────────────────────
def main(argv):
    args, words, limit, extra = [], [], None, []
    it = iter(argv)
    for a in it:
        if a == "--":
            extra = list(it)
            break
        if a == "-n":
            limit = int(next(it, "0"))
        elif a.startswith("-n") and a[2:].isdigit():
            limit = int(a[2:])
        elif a.startswith("-"):
            args.append(a)
        else:
            words.append(a)
    query = " ".join(words)
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return 0

    want_resume = bool({"-r", "--resume", "-R", "--resume-skip-permissions"} & set(args))
    want_focus = ("-f" in args or "--focus" in args) or (sys.stdout.isatty() and "--no-focus" not in args)
    skip_perms = "-R" in args or "--resume-skip-permissions" in args

    tools = tuple(t for t in ("claude", "codex") if "--" + t in args) or ("claude", "codex")
    sessions = load_sessions(live_only="--live" in args, limit=limit, tools=tools)
    color = sys.stderr.isatty() and "--no-color" not in args

    if "--json" in args:
        print(json.dumps(filter_sessions(sessions, query), indent=2))
        return 0
    if not sessions:
        print("no Claude Code or Codex sessions found", file=sys.stderr)
        return 1

    interactive = sys.stdin.isatty() and sys.stderr.isatty() and not ("-l" in args or "--list" in args)
    if not interactive:
        matches = filter_sessions(sessions, query)
        if "--cwd" in args or "--name" in args or want_resume or "-f" in args or "--focus" in args:
            if not matches:
                return 1
            d = matches[0]
            if want_resume and not d.get("alive"):
                return resume(d, extra, skip_perms)
            if want_resume or "-f" in args or "--focus" in args:
                if not d.get("alive"):
                    print(f"{d.get('name')} is not running (resume with -r)", file=sys.stderr)
                    return 1
                return 0 if focus(d) else 1
            print(d.get("cwd") if "--cwd" in args else d.get("name"))
            return 0
        print_table(matches, color and sys.stdout.isatty())
        return 0

    chosen = pick(sessions, query)
    if chosen is None:
        return 130
    if want_resume:
        if not chosen.get("alive"):
            return resume(chosen, extra, skip_perms)
        # A live session cannot be resumed a second time; go to its window instead.
        print(f"{DIM}{chosen.get('name')} is already running, focusing its window{RESET}", file=sys.stderr)
        return 0 if focus(chosen) else 1
    if want_focus and chosen.get("alive"):
        focus(chosen)
    if "--cwd" in args:
        print(chosen.get("cwd"))
    elif "--name" in args:
        print(chosen.get("name"))
    else:
        dot, st = status_dot(chosen)
        tail = f"pid {chosen.get('pid')}  {st}" if chosen.get("alive") else \
            f"{st}  revive: {' '.join(resume_cmd(chosen))}"
        print(f"{dot} {BOLD}{chosen.get('name')}{RESET}  {DIM}{short_cwd(chosen.get('cwd'))}  "
              f"{tail}{RESET}", file=sys.stderr)
        print(chosen.get("sessionId"))
    return 0


def resume_cmd(d, skip_permissions=False, extra=()):
    if d.get("tool") == "codex":
        flags = ["--dangerously-bypass-approvals-and-sandbox"] if skip_permissions else []
        return ["codex", "resume", *flags, d.get("sessionId"), *extra]
    flags = ["--dangerously-skip-permissions"] if skip_permissions else []
    return ["claude", "--resume", d.get("sessionId"), *flags, *extra]


def resume(d, extra=(), skip_permissions=False):
    """Replace this process with `claude --resume` / `codex resume` in the session's cwd."""
    cwd = d.get("cwd")
    if cwd and os.path.isdir(cwd):
        os.chdir(cwd)
    else:
        print(f"warning: cwd {cwd!r} missing, resuming from here", file=sys.stderr)
    cmd = resume_cmd(d, skip_permissions, extra)
    print(f"{DIM}{' '.join(cmd)}  ({short_cwd(cwd)}){RESET}", file=sys.stderr)
    try:
        os.execvp(cmd[0], cmd)
    except OSError as e:
        print(f"failed to exec {cmd[0]}: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
